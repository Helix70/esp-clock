CONFIG_IDF_TARGET="esp32c5"

# Console - USB Serial JTAG by default
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# WiFi
CONFIG_ESP_WIFI_ENABLED=y

# SNTP - sync every hour
CONFIG_LWIP_SNTP_MAX_SERVERS=1
CONFIG_LWIP_SNTP_UPDATE_DELAY=3600000

# Display scan ISR keeps running while flash is busy (NVS, OTA writes)
CONFIG_GPTIMER_ISR_CACHE_SAFE=y

# OTA: roll back to the previous image if a new one fails to start
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Stack overflow detection
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

# Performance optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
